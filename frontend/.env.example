DATABASE_URL=
DATABASE_URL_DIRECT=
APP_ORIGIN=http://localhost:5173
OWNER_SUBJECT=
# Set to enabled to let anyone browse a read-only copy of the library at /public.
LIBRARY_PUBLIC_VIEW=
NEON_AUTH_BASE_URL=
# Neon Object Storage for person photos. Locally, `neon deploy` / `neon env pull` writes the
# AWS_* equivalents, which are read as a fallback; on Vercel, set these (it reserves AWS_*).
NEON_STORAGE_BUCKET=uploads
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

NEON_AUTH_COOKIE_SECRET=
# Set to 1 only for the upgrade run, after backing up or branching the database.
PRISM_CONFIRM_UPGRADE=

				}
			}
		},
		"shape": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"radius": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"sm": {
							"type": "number",
							"minimum": 0,
							"maximum": 40
						},
						"control": {
							"type": "number",
							"minimum": 0,
							"maximum": 40
						},
						"card": {
							"type": "number",
							"minimum": 0,
							"maximum": 40
						},
						"panel": {
							"type": "number",
							"minimum": 0,
							"maximum": 40
						}
					}
				}
			}

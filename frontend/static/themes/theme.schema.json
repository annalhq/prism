					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"shadow-strong": {

		"typography": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"sans": {
					"type": "string",
					"maxLength": 200,
					"description": "Up to 4 installed font family names, comma separated."
				},
				"mono": {
					"type": "string",
					"maxLength": 200,
					"description": "Up to 4 installed font family names, comma separated."
				},
				"display": {

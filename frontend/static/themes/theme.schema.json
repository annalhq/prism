{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Prism theme or module",
	"type": "object",
	"additionalProperties": false,
	"required": ["prism", "name"],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"prism": {
			"const": 1
		},
		"kind": {
			"enum": ["theme", "module"],
			"default": "theme"
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64
		},
		"author": {
			"type": "string",
			"maxLength": 120
		},
		"description": {
			"type": "string",
			"maxLength": 160
		},
		"scheme": {
			"enum": ["dark", "light"],
			"description": "Required for themes; not allowed on modules."
		},
		"palette": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"background": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"foreground": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"accent": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"danger": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"warning": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				}
			},
			"required": ["background", "foreground"]
		},
		"colors": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"canvas": {
					"type": "string",
					"maxLength": 96,
					"pattern": "^(#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?|hwb|lab|lch|oklab|oklch)\\([0-9\\s,/%.+deEgnorturad-]*\\)|transparent)$"
				},
				"surface": {

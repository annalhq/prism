{
	"name": "prism",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": ">=22.17"
	},
	"workspaces": [
		"frontend",
		"extensions/*"
	],
	"scripts": {
		"dev": "bun run --cwd frontend dev",
		"dev:firefox": "bun run --cwd extensions/firefox dev",
		"dev:chrome": "bun run --cwd extensions/chrome dev",
		"build": "bun run --cwd frontend build",
		"build:extensions": "bun run build:firefox && bun run build:chrome",
		"build:firefox": "bun run --cwd extensions/firefox build",
		"build:chrome": "bun run --cwd extensions/chrome build",
		"zip:extensions": "bun run zip:firefox && bun run zip:chrome",
		"zip:firefox": "bun run --cwd extensions/firefox zip",
		"zip:chrome": "bun run --cwd extensions/chrome zip",
		"sign:firefox": "bun run --cwd extensions/firefox sign",
		"build:vercel": "rm -rf .vercel/output && bun run --cwd frontend build && mkdir -p .vercel && cp -R frontend/.vercel/output .vercel/output",
		"preview": "bun run --cwd frontend preview",
		"check": "bun run --cwd frontend check && bun run --cwd extensions/firefox check && bun run --cwd extensions/chrome check",
		"lint": "bun run --cwd frontend lint",
		"format": "bun run --cwd frontend format",
		"test": "bun run --cwd frontend test",
		"test:integration": "bun run --cwd frontend test:integration",
		"test:e2e": "bun run --cwd frontend test:e2e",
		"bench": "bun run --cwd frontend bench",
		"bench:library": "bun run --cwd frontend bench:library",
		"db:generate": "bun run --cwd frontend db:generate",
		"db:migrate": "bun run --cwd frontend db:migrate",
		"db:inventory": "bun run --cwd frontend db:inventory",
		"db:init-owner": "bun run --cwd frontend db:init-owner",
		"release": "commit-and-tag-version",
		"release:first": "commit-and-tag-version --first-release",
		"release:dry": "commit-and-tag-version --dry-run"
	},
	"devDependencies": {
		"commit-and-tag-version": "^13.3.0"
	}
}
